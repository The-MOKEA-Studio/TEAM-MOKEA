{
  "name": "@the-mokea-studio/team-mokea",
  "version": "1.1.24",
  "description": "Multi-account proxy for Claude Code and Codex: pools Claude Max, ChatGPT/Codex, API-key and third-party backend accounts, and rotates on quota",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "team-mokea": "src/cli.js",
    "teamclaude": "src/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test --test-timeout=120000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:strict": "node scripts/typecheck-strict.mjs"
  },
  "keywords": [
    "claude",
    "anthropic",
    "claude-code",
    "codex",
    "openai",
    "chatgpt",
    "deepseek",
    "proxy",
    "load-balancer",
    "multi-account",
    "quota",
    "rate-limiting",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-MOKEA-Studio/TEAM-MOKEA.git"
  },
  "bugs": {
    "url": "https://github.com/The-MOKEA-Studio/TEAM-MOKEA/issues"
  },
  "homepage": "https://github.com/The-MOKEA-Studio/TEAM-MOKEA#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "teamcodex": "https://codeload.github.com/MOKEA-Studio/Team-MOKEA/tar.gz/691911b149a60996f84db8f8d086e8684d8ce4db"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "eslint": "^9.0.0",
    "typescript": "5.9.2"
  }
}
